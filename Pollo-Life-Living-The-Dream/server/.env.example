# ---------- Server ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---------- MongoDB Atlas ----------
# Atlas → your cluster → Connect → Drivers → copy the string, put your password in,
# and add the database name before the "?" (here: finvillage)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finvillage?retryWrites=true&w=majority
MONGODB_DB=finvillage

# ---------- Capital One Nessie ----------
# Get a key at http://api.nessieisreal.com (sign in → "Your API key")
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
# How long a cached bank snapshot is reused before calling Nessie again (seconds)
NESSIE_CACHE_SECONDS=120

#NEMOTRON API_KEY 
  NVIDIA_API_KEY= #MARTIN PUT DAT HERE!(in actual .env file not in .enc.example)